{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KisanSaathiCropConfig",
  "type": "object",
  "required": [
    "crop_id",
    "common_name_en",
    "common_name_hi",
    "common_name_mr",
    "scientific_name",
    "typical_duration_days",
    "region",
    "citations",
    "general_thresholds",
    "stages"
  ],
  "properties": {
    "crop_id": { "type": "string" },
    "common_name_en": { "type": "string" },
    "common_name_hi": { "type": "string" },
    "common_name_mr": { "type": "string" },
    "scientific_name": { "type": "string" },
    "typical_duration_days": { "type": "integer", "minimum": 30, "maximum": 365 },
    "region": { "type": "string" },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document", "section"],
        "properties": {
          "document": { "type": "string" },
          "section": { "type": "string" }
        }
      }
    },
    "general_thresholds": {
      "type": "object",
      "required": [
        "heat_stress_warning_c",
        "heat_stress_source",
        "frost_stress_warning_c",
        "frost_stress_source",
        "excess_rain_24h_mm",
        "excess_rain_source"
      ]
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage_id",
          "name_en",
          "name_hi",
          "name_mr",
          "das_start",
          "das_end",
          "critical_for_irrigation",
          "moisture",
          "temperature",
          "spraying"
        ]
      }
    }
  }
}
