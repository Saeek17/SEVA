# ==============================================================================
# KisanSaathi Environment Configuration
# ==============================================================================

# Application Meta
APP_NAME=KisanSaathi
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Database Connection
# SQLite (default for local zero-dependency testing):
DATABASE_URL=sqlite:///./kisansaathi.db
# PostgreSQL / Supabase (production / Docker):
# DATABASE_URL=postgresql://kisansaathi_user:kisansaathi_password@localhost:5432/kisansaathi_db

# Security & Encryption (Fernet 32-byte URL-safe base64 string)
# Encrypts farmer phone numbers at rest to comply with privacy regulations
ENCRYPTION_KEY=rV2wYpE8Z6tX0cM3vB1nK7jH5fD4sA9qL2wE5rT8yU1=
SECRET_KEY=kisansaathi-super-secret-jwt-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Dry-Run & Simulation Flags
# Set DRY_RUN=true to run the entire system offline or without paid external keys
DRY_RUN=true
# Set MOCK_DATA=true only if you have zero internet connection and want simulated weather
MOCK_DATA=false

# Large Language Model (Gemini API)
# Used ONLY for natural vernacular phrasing, NEVER for deciding agricultural actions
GEMINI_API_KEY=

# Telecom Delivery Providers (Twilio)
# Provider interface allows seamless swap with Exotel or Kaleyra for India production
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=+15005550006

# Text-to-Speech (Google Cloud TTS)
# Synthesizes voice advisories in Hindi (hi-IN), Marathi (mr-IN), and English
GOOGLE_APPLICATION_CREDENTIALS=

# Environmental Cache TTLs (in seconds)
CACHE_WEATHER_TTL_SEC=10800       # 3 hours for Open-Meteo forecast
CACHE_HISTORICAL_TTL_SEC=86400    # 24 hours for NASA POWER 30-day rain
CACHE_SOIL_TTL_SEC=31536000       # Permanent (1 year+) for ISRIC SoilGrids

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
